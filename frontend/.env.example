# Backend API base URL (CloneOS)
REACT_APP_BASE_URL=http://localhost:3001

# Razorpay public key (same value as backend RAZORPAY_KEY_ID)
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id

# Python training / LoRA backend (optional)
REACT_APP_TRAINING_API_URL=

# Google Sign-In client id (optional)
REACT_APP_GOOGLE_CLIENT_ID=
